# Airtable — https://airtable.com/create/tokens
AIRTABLE_API_KEY=pat_xxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX

# Optional: override default table names
# AIRTABLE_PRODUCTS_TABLE=Products
# AIRTABLE_PRICE_HISTORY_TABLE=Price History

# Optional: override Shopify store domain (defaults to feastitaly.com)
# SHOPIFY_STORE_DOMAIN=feastitaly.com
# SHOPIFY_COLLECTION_HANDLE=short-dated-but-delicious

# Optional: further-reduction threshold (must meet BOTH)
# SIGNIFICANT_DROP_PERCENT=5
# SIGNIFICANT_DROP_AMOUNT=0.50
